# Security Configuration
# IMPORTANT: Change these values before deploying to production

# Security Code for Dashboard Access
SECURITY_CODE=your-secure-code-here

# JWT Secret Key for token signing (generate a strong random string)
# You can generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-jwt-secret-key-here

# Anthropic API Configuration
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model configuration - Using Claude Sonnet 4 (latest)
# Other options: claude-3-5-sonnet-20241022, claude-3-opus-20240229
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional: Set max tokens for responses (default: 2000)
MAX_TOKENS=4096

# Security Code for Dashboard Access
# IMPORTANT: Change this to a secure code before deploying to production
SECURITY_CODE=your-secure-code-here

# Allowed frontend origins for CORS (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000

# Database connection string (Postgres via Supabase)
DATABASE_URL=postgresql://postgres:<YOUR_DB_PASSWORD>@db.fplrunmcv...supabase.co:5432/postgres
